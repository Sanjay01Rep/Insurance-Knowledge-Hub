# Fill in the keys you actually use. Never share this file.
# Never paste keys into the app’s chat box.

# Leave ANSWER_PROVIDER blank: the app uses whichever model key you paste below.
# If you paste more than one key, set this to gemini / openai / anthropic / cursor / azure.
ANSWER_PROVIDER=gemini

# --- Answer models (paste the key you want to use; leave the rest empty) ---

# 1) Gemini (Google, free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# 2) ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3) Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# 4) Cursor — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# 5) Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Optional web fallback when nothing is in your uploaded documents ---
# Tavily Search API  POST https://api.tavily.com/search
# Get a key: https://app.tavily.com/
# Only your typed question is sent. Excel/PDF/file contents are never sent.
TAVILY_API_KEY=
